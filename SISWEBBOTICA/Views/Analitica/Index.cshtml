@model SISWEBBOTICA.ViewModels.DashboardAnaliticaVM
@{
    ViewData["Title"] = "Analítica e IA - Predicción de Demanda";
}

<div class="container mt-4">
    <div class="row mb-4">
        <div class="col-12">
            <h2><i class="fas fa-chart-line text-primary"></i> Analítica Inteligente y Predicción de Demanda</h2>
            <p class="text-muted">Sistema de IA para optimización de ventas y compras</p>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- KPIs Principales -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card bg-primary text-white h-100">
                <div class="card-body">
                    <h5 class="card-title">Ventas Hoy</h5>
                    <h2 class="mb-0">S/ @Model.VentaTotalHoy.ToString("N2")</h2>
                    <small>@Model.ProductosVendidosHoy productos vendidos</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-success text-white h-100">
                <div class="card-body">
                    <h5 class="card-title">Ventas del Mes</h5>
                    <h2 class="mb-0">S/ @Model.VentaTotalMes.ToString("N2")</h2>
                    <small>Acumulado mensual</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-info text-white h-100">
                <div class="card-body">
                    <h5 class="card-title">Tickets Hoy</h5>
                    <h2 class="mb-0">@Model.TicketsPromedio</h2>
                    <small>Atenciones realizadas</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-warning text-white h-100">
                <div class="card-body">
                    <h5 class="card-title">Alertas de Stock</h5>
                    <h2 class="mb-0">@Model.AlertasStock.Count</h2>
                    <small>Productos por reponer</small>
                </div>
            </div>
        </div>
    </div>

    <!-- Botón de Entrenamiento -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title"><i class="fas fa-brain"></i> Entrenar Modelo de IA</h5>
                    <p class="card-text">El sistema analiza las ventas históricas para mejorar las predicciones. Se recomienda entrenar semanalmente.</p>
                    <div class="d-flex gap-2">
                        <form asp-action="Predecir" method="post">
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-play"></i> Entrenar Modelo Ahora
                            </button>
                        </form>
                    </div>

                    @* Métricas del último entrenamiento *@
                    @if (Model.MetricRMSE > 0 || Model.MetricRSquared > 0)
                    {
                        <div class="mt-3">
                            <small class="text-muted">Último entrenamiento: RMSE = @Model.MetricRMSE.ToString("N3"), R² = @Model.MetricRSquared.ToString("N3")</small>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Alertas de Stock -->
    <div class="row mb-4">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header bg-danger text-white">
                    <h5 class="mb-0"><i class="fas fa-exclamation-triangle"></i> Alertas de Stock (Productos Críticos)</h5>
                </div>
                <div class="card-body">
                    @if (Model.AlertasStock.Any())
                    {
                        <table class="table table-sm table-striped">
                            <thead>
                                <tr>
                                    <th>Producto</th>
                                    <th>Stock</th>
                                    <th>Mínimo</th>
                                    <th>Recomendación</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.AlertasStock.Take(5))
                                {
                                    <tr>
                                        <td>@item.NombreProducto</td>
                                        <td class="text-danger">@item.StockActual</td>
                                        <td>@item.StockMinimo</td>
                                        <td>
                                            @if (item.Recomendacion == "Comprar Urgente")
                                            {
                                                <span class="badge bg-danger">@item.Recomendacion</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning">@item.Recomendacion</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        <a asp-action="DetallePredicciones" class="btn btn-sm btn-outline-primary">Ver todos</a>
                    }
                    else
                    {
                        <p class="text-muted mb-0">No hay productos con stock crítico.</p>
                    }
                </div>
            </div>
        </div>

        <!-- Productos Más Vendidos -->
        <div class="col-md-6">
            <div class="card">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0"><i class="fas fa-fire"></i> Productos Más Vendidos (Último Mes)</h5>
                </div>
                <div class="card-body">
                    @if (Model.ProductosMasVendidos.Any())
                    {
                        <table class="table table-sm table-striped">
                            <thead>
                                <tr>
                                    <th>Producto</th>
                                    <th>Ventas Prom.</th>
                                    <th>Stock</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.ProductosMasVendidos.Take(5))
                                {
                                    <tr>
                                        <td>@item.Nombre</td>
                                        <td>@item.VentasPromedio.ToString("N1")</td>
                                        <td>@item.Stock</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        <a asp-action="ProductosMasVendidos" class="btn btn-sm btn-outline-success">Ver ranking completo</a>
                    }
                    else
                    {
                        <p class="text-muted mb-0">No hay ventas registradas en el período.</p>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Predicciones y Lenta Rotación -->
    <div class="row">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0"><i class="fas fa-chart-bar"></i> Predicciones para la Próxima Semana</h5>
                </div>
                <div class="card-body">
                    @if (Model.Predicciones.Any())
                    {
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Producto</th>
                                    <th>Ventas Estimadas</th>
                                    <th>Confianza</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Predicciones.Take(5))
                                {
                                    <tr>
                                        <td>@item.NombreProducto</td>
                                        <td>@item.CantidadPredicha.ToString("N0") und.</td>
                                        <td>
                                            <div class="progress" style="height: 20px;">
                                                <div class="progress-bar bg-info" role="progressbar" 
                                                     style="width: @(item.Confianza * 100)%">
                                                    @(item.Confianza * 100)%
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card">
                <div class="card-header bg-secondary text-white">
                    <h5 class="mb-0"><i class="fas fa-snail"></i> Productos de Lenta Rotación</h5>
                </div>
                <div class="card-body">
                    @if (Model.ProductosLentaRotacion.Any())
                    {
                        <table class="table table-sm table-striped">
                            <thead>
                                <tr>
                                    <th>Producto</th>
                                    <th>Stock</th>
                                    <th>Ventas/Mes</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.ProductosLentaRotacion.Take(5))
                                {
                                    <tr>
                                        <td>@item.Nombre</td>
                                        <td class="text-warning">@item.Stock</td>
                                        <td class="text-muted">@item.VentasPromedio.ToString("N2")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        <small class="text-muted">⚠️ No comprar estos productos - Stock estancado</small>
                    }
                    else
                    {
                        <p class="text-muted mb-0">Todos los productos tienen buena rotación.</p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>