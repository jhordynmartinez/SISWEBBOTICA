@model SISWEBBOTICA.ViewModels.RegistroVM
@{
    ViewData["Title"] = "Registro";
}

<link rel="stylesheet" href="~/css/registro.css" />

<div class="auth-wrapper">
    <div class="auth-card shadow-lg rounded-4">
        <div class="auth-header text-center">
            <img src="~/img/logo.png" alt="Logo Botica" class="logo" />
            <h2 class="mt-3">Crear Cuenta</h2>
            <p class="text-muted">Completa los datos para registrarte</p>
        </div>

        <form asp-action="Registro" method="post" class="auth-form p-4">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Nombre" class="form-label"></label>
                <input asp-for="Nombre" class="form-control" placeholder="Ej: Juan Pérez" />
                <span asp-validation-for="Nombre" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Login" class="form-label"></label>
                <input asp-for="Login" class="form-control" placeholder="Ej: usuario@botica.com" />
                <span asp-validation-for="Login" class="text-danger small"></span>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Contrasena" class="form-label"></label>
                    <input asp-for="Contrasena" class="form-control" type="password" placeholder="••••••••" />
                    <span asp-validation-for="Contrasena" class="text-danger small"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="ConfirmarContrasena" class="form-label"></label>
                    <input asp-for="ConfirmarContrasena" class="form-control" type="password" placeholder="••••••••" />
                    <span asp-validation-for="ConfirmarContrasena" class="text-danger small"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="RolSeleccionado" class="form-label"></label>
                @if ((bool)ViewBag.PermitirAdmin)
                {
                    <select asp-for="RolSeleccionado" asp-items="ViewBag.TiposUsuario" class="form-select">
                        <option value="">-- Selecciona un Rol --</option>
                    </select>
                }
                else
                {
                    <select asp-for="RolSeleccionado" class="form-select">
                        <option value="">-- Selecciona un Rol --</option>
                        <option value="Vendedor">Vendedor</option>
                    </select>
                }
                <span asp-validation-for="RolSeleccionado" class="text-danger small"></span>
            </div>

            <div class="d-grid">
                <button type="submit" class="btn btn-success">Registrarse</button>
            </div>

            <div class="text-center mt-3">
                <a asp-action="Login" class="link-secondary">¿Ya tienes cuenta? Inicia sesión</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}