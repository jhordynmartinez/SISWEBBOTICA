@model SISWEBBOTICA.Models.Cliente
@{
    ViewData["Title"] = "Eliminar Cliente";
}

<div class="container mt-5">
    <div class="row">
        <div class="col-md-6 offset-md-3">
            <div class="card border-danger">
                <div class="card-header bg-danger text-white">
                    <h5 class="mb-0"><i class="fas fa-trash me-2"></i> Eliminar Cliente</h5>
                </div>
                <div class="card-body">
                    <div class="alert alert-warning">
                        <strong>¿Estás seguro?</strong> Esta acción no se puede deshacer.
                    </div>

                    <p><strong>RUC/DNI:</strong> @Model.RucDni</p>
                    <p><strong>Nombre:</strong> @Model.Nombre @Model.Apellido</p>
                    <p><strong>Teléfono:</strong> @Model.Telefono</p>
                    <p><strong>Email:</strong> @Model.Email</p>

                    <form asp-action="DeleteConfirmed" method="post" class="d-inline">
                        <input type="hidden" asp-for="IdCliente" />
                        <button type="submit" class="btn btn-danger">
                            <i class="fas fa-trash me-1"></i> Sí, Eliminar
                        </button>
                        <a href="@Url.Action("Index")" class="btn btn-secondary">Cancelar</a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
