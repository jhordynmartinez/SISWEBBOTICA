@model IEnumerable<SISWEBBOTICA.Models.Cliente>
@{
    ViewData["Title"] = "Lista de Clientes";
}
<head>
    <script src="https://cdn.userway.org/widget.js" data-account="HuIjx9seHZ"></script>

    <style>        .userway_buttons_wrapper, #userway-widget-container {
            top: 120px !important;
            right: -40px !important;
            position: fixed !important;
        }
    </style>
</head>
<h1>@ViewData["Title"]</h1>

<table class="table">
    <thead>
        <tr>
            <th>Nombre</th>
            <th>Apellido</th>
            <th>DNI/RUC</th>
            <th>Teléfono</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Nombre</td>
                <td>@item.Apellido</td>
                <td>@item.RucDni</td>
                <td>@item.Telefono</td>
            </tr>
        }
    </tbody>
</table>